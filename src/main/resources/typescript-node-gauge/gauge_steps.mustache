{{#apiInfo}}
{{#apis}}
{{#operations}}
export * from '../api/{{ classFilename }}';
import { {{ classname }}{{#hasApiKeyMethods}}, {{classname}}ApiKeys{{/hasApiKeyMethods}} } from '../api/{{ classFilename }}';
{{/operations}}
{{#withInterfaces}}
export * from './{{ classFilename }}Interface'
{{/withInterfaces}}
{{/apis}}
{{/apiInfo}}
import * as http from 'http';
import * as assert from 'assert';
import { BeforeSuite, Step, Table, AfterScenario } from "gauge-ts";
import * as contentType from 'content-type';
import { ObjectSerializer } from '../model/models';
import { JSONPath } from 'jsonpath-plus';

class TestContext {
    public request: Request;
    public response: { message: http.IncomingMessage, body: any };
    public previousResponse: { message: http.IncomingMessage, body: any };
    public targetHost: string | undefined;
    public accessToken: string | undefined;
    public securityScheme: string | undefined;
    public apiKey: string | undefined;
    public apiKeyPrefix: string | undefined;
}

const ctx = new TestContext();

export class StepImplementation {
    @BeforeSuite()
    public beforeSuite() {
        const defaultHost: string = "{{gaugeTargetHost}}";

        ctx.targetHost = process.env.gauge_target_host;
        ctx.accessToken = process.env.gauge_access_token?.trim();
        ctx.securityScheme = process.env.gauge_security_scheme?.trim();
        ctx.apiKey = process.env.gauge_api_key?.trim();
        ctx.apiKeyPrefix = process.env.gauge_api_key_prefix?.trim();
        ctx.previousResponse = undefined;

        if (!ctx.targetHost) {
            ctx.targetHost = defaultHost;
        }

        if (!ctx.targetHost) {
            throw new Error("Missing required configuration: 'gauge_target_host'. Please set the gauge_target_host environment variable, or pass it during generation with -p gaugeTargetHost=http://your-api");
        }

        {{^hasHttpBearerMethods}}
        if (ctx.accessToken) {
            throw new Error("An access token has been set but the OpenAPI specification has no HTTP bearer authentication methods");
        }
        {{/hasHttpBearerMethods}}

        {{^hasApiKeyMethods}}
        if (ctx.apiKey) {
            throw new Error("An API key has been set but the OpenAPI specification has no API key authentication methods");
        }
        {{/hasApiKeyMethods}}
    }

    @Step("Create a <operationId> request for the <classname>")
    public createARequestForApi(operationId: string, classname: string) {
        ctx.request = new Request(classname, operationId);
    }

    @Step("Create an <operationId> request for the <classname>")
    public createAnRequestForApi(operationId: string, classname: string) {
        ctx.request = new Request(classname, operationId);
    }

    @Step("Give the <parameter> parameter a value of <value>")
    public giveTheParameterAValueOf(parameter: string, value: string) {
        {{#apiInfo.apis}}
        if (ctx.request.classname == "{{#lambda.pascalcase}}{{classname}}{{/lambda.pascalcase}}") {
            {{#operations}}
            {{#operation}}
            if (ctx.request.operationId == "{{#lambda.camelcase}}{{operationId}}{{/lambda.camelcase}}") {
                {{#allParams}}
                if (parameter == "{{baseName}}") {
                    {{^isContainer}}
                    ctx.request.parameters["{{baseName}}"] = value;
                    return;
                    {{/isContainer}}
                    {{#isContainer}}
                    throw new Error("Cannot set collection parameter {{baseName}} from String value");
                    {{/isContainer}}
                }
                {{^-last}}

                {{/-last}}
                {{/allParams}}
            }
            {{^-last}}

            {{/-last}}
            {{/operation}}
            {{/operations}}
        }
        
        {{/apiInfo.apis}}
        throw new Error(`${ctx.request.classname}.${ctx.request.operationId} does not have a parameter called ${parameter}`);
    }

    @Step("Give the <parameter> parameter a JSON value of <value>")
    public giveTheParameterAJsonValueOf(parameter: string, value: string)  {
        {{#apiInfo.apis}}
        if (ctx.request.classname == "{{#lambda.pascalcase}}{{classname}}{{/lambda.pascalcase}}") {
            {{#operations}}
            {{#operation}}
            if (ctx.request.operationId == "{{#lambda.camelcase}}{{operationId}}{{/lambda.camelcase}}") {
                {{#allParams}}
                if (parameter == "{{baseName}}") {
                    {{^isFile}}
                    ctx.request.parameters["{{baseName}}"] = ObjectSerializer.deserialize(JSON.parse(value), "{{dataType}}");
                    return;
                    {{/isFile}}
                    {{#isFile}}
                    throw new Error("Cannot set file parameter {{baseName}} from JSON value");
                    {{/isFile}}
                }
                {{^-last}}

                {{/-last}}
                {{/allParams}}
            }
            {{^-last}}

            {{/-last}}
            {{/operation}}
            {{/operations}}
        }

        {{/apiInfo.apis}}
        throw new Error(`${ctx.request.classname}.${ctx.request.operationId} does not have a parameter called ${parameter}`);
    }

    @Step("Give the <parameter> parameter the following values: <table>")
    public giveTheParameterTheFollowingValues(parameter: string, table: Table) { 
        {{#apiInfo.apis}}
        if (ctx.request.classname == "{{#lambda.pascalcase}}{{classname}}{{/lambda.pascalcase}}") {
            {{#operations}}
            {{#operation}}
            if (ctx.request.operationId == "{{#lambda.camelcase}}{{operationId}}{{/lambda.camelcase}}") {
                {{#allParams}}
                if (parameter == "{{baseName}}") {
                    {{#isContainer}}
                    const collection: any[] = [];
                    for (const row of table.getTableRows()) {
                        const value: any = row.getCell("value");
                        collection.push(value);
                    }

                    ctx.request.parameters["{{baseName}}"] = collection;
                    return;
                    {{/isContainer}}
                    {{^isContainer}}
                    throw new Error("Cannot read a DataTable into non-collection parameter {{baseName}}");
                    {{/isContainer}}
                }
                {{^-last}}

                {{/-last}}
                {{/allParams}}
            }
            {{^-last}}

            {{/-last}}
            {{/operation}}
            {{/operations}}
        }

        {{/apiInfo.apis}}
        throw new Error(`${ctx.request.classname}.${ctx.request.operationId} does not have a parameter called ${parameter}`);
    }

    @Step("the <parameter> parameter is <jsonPath> from the previous response")
    public theParameterIsFromPreviousResponse(parameter: string, jsonPath: string) {
        if (!ctx.previousResponse) {
            throw new Error('No previous response exists.');
        }
        if (!ctx.previousResponse.message.headers['content-type']?.includes('application/json')) {
            throw new Error('Previous response is not JSON.');
        }
        const value = JSONPath({ path: jsonPath, json: ctx.previousResponse.body });
        if (!value || (Array.isArray(value) && value.length === 0)) {
            throw new Error(`No value found for JSON Path: ${jsonPath}`);
        }
        if (!ctx.request) {
            throw new Error('Request is not initialized');
        }
        ctx.request.parameters[parameter] = Array.isArray(value) ? value[0] : value;
    }

    @Step("Send the request")
    public async sendTheRequest() {
        {{#apiInfo.apis}}
        if (ctx.request.classname == "{{#lambda.pascalcase}}{{classname}}{{/lambda.pascalcase}}") {
            const api: {{classname}} = new {{classname}}(ctx.targetHost);

            {{#hasHttpBearerMethods}}
            if (ctx.accessToken) {
                api.accessToken = ctx.accessToken;
            }
            {{/hasHttpBearerMethods}}

            {{#hasApiKeyMethods}}
            if (ctx.apiKey)
            {
                if (!ctx.securityScheme) {
                    throw new Error("Missing required configuration: 'gauge_security_scheme'. When using an API key, please also set the gauge_security_scheme environment variable");
                }

                if (ctx.apiKeyPrefix) {
                    ctx.apiKey = `${ctx.apiKeyPrefix} ${ctx.apiKey}`;
                }

                api.setApiKey({{classname}}ApiKeys[ctx.securityScheme], ctx.apiKey);
            }
            {{/hasApiKeyMethods}}

            {{#operations}}
            {{#operation}}
            if (ctx.request.operationId == "{{#lambda.camelcase}}{{operationId}}{{/lambda.camelcase}}") {
                let { response, body } = await api.{{operationId}}({{#allParams}}ctx.request.parameters["{{baseName}}"]{{^-last}}, {{/-last}}{{/allParams}});
                ctx.response = { message: response, body };
                ctx.previousResponse = { message: response, body };
            }
            {{^-last}}

            {{/-last}}
            {{/operation}}
            {{/operations}}
        }
        {{/apiInfo.apis}}
    }

    @Step("The response status should be <statusCode>")
    public thenTheResponseStatusIs(statusCode: string) {
        assert.strictEqual(ctx.response.message.statusCode, parseInt(statusCode), `Expected response status to be ${statusCode} but got ${ctx.response.message.statusCode}`);
    }

    @Step("The response content should be <content>")
    public theResponseContentShouldBe(content: string) {
        const { type } = contentType.parse(ctx.response.message.headers["content-type"]);

        if (type == "application/json") {
            const actual: any = JSON.parse(JSON.stringify(ctx.response.body));
            const expected: any = JSON.parse(content);

            assert.deepStrictEqual(actual, expected, `Expected response data to be '${content}' but got '${JSON.stringify(actual)}'`);
        } else {
            throw new Error("Cannot assert against unsupported content type: " + type);
        }
    }

    @Step("The response content should contain the subtree: <content>")
    public theResponseContentShouldContainTheSubtree(content: string) {
        const { type } = contentType.parse(ctx.response.message.headers["content-type"]);

        if (type == "application/json") {
            const actual: any = JSON.parse(JSON.stringify(ctx.response.body));
            const expected: any = JSON.parse(content);

            function containsSubtree(actual: any, expected: any): boolean {
                if (typeof expected !== 'object' || expected === null) {
                    return actual === expected;
                }
                if (Array.isArray(expected)) {
                    if (!Array.isArray(actual)) return false;
                    for (const expectedItem of expected) {
                        if (!actual.some((actualItem: any) => containsSubtree(actualItem, expectedItem))) {
                            return false;
                        }
                    }
                    return true;
                }
                for (const key in expected) {
                    if (!(key in actual)) return false;
                    if (!containsSubtree(actual[key], expected[key])) return false;
                }
                return true;
            }

            assert.ok(containsSubtree(actual, expected), `Response does not contain the expected subtree: ${content}`);
        } else {
            throw new Error("Cannot assert against unsupported content type: " + type);
        }
    }

    @AfterScenario()
    public afterScenario() {
        ctx.previousResponse = undefined;
    }
}

class Request {
    private _classname: string;
    private _operationId: string;
    private _parameters: { [name: string]: any } = {};

    public constructor(classname: string, operationId: string) {
        this._classname = classname;
        this._operationId = operationId;
    }

    public get classname(): string {
        return this._classname;
    }

    public get operationId(): string {
        return this._operationId;
    }

    public get parameters(): { [name: string]: any } {
        return this._parameters;
    }
}